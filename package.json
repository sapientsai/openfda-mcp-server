{
  "name": "openfda-mcp-server",
  "version": "2.1.1",
  "description": "MCP server for querying U.S. FDA public datasets - drugs, devices, adverse events, recalls, and more",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fda",
    "openfda",
    "drugs",
    "medical-devices",
    "somamcp",
    "typescript"
  ],
  "author": "jordan.burke@gmail.com",
  "license": "MIT",
  "homepage": "https://github.com/sapientsai/openfda-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapientsai/openfda-mcp-server"
  },
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "eslint ./src ./test --fix --max-warnings=0",
    "lint:check": "eslint ./src ./test --max-warnings=0",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev",
    "serve:test": "tsx src/index.ts",
    "serve:test:http": "tsx src/index.ts --transport http",
    "prepublishOnly": "pnpm validate"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "debug": "^4.4.3",
    "fflate": "^0.8.3",
    "functype": "^1.26.0",
    "somamcp": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.2",
    "ts-builds": "^4.2.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15"
  },
  "type": "module",
  "bin": {
    "openfda-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "lib",
    "dist"
  ],
  "prettier": "ts-builds/prettier",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22.12"
  }
}
